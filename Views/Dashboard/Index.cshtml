@model IEnumerable<SistemaVentas.Models.Venta>

@{
    ViewData["Title"] = "Panel de Control";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="font-weight-bold mb-0">Panel Principal</h2>
        <a asp-controller="Ventas" asp-action="Create" class="btn btn-success font-weight-bold">
            Nueva Venta
        </a>
    </div>

    <!-- Seccion de Alertas Importantes -->
    @if (ViewBag.Alertas != null && ((List<string>)ViewBag.Alertas).Any())
    {
        <div class="mb-4">
            @foreach (var alerta in (List<string>)ViewBag.Alertas)
            {
                <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                    <span class="me-2">Ojo⚠️</span>
                    <div>@alerta</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>
    }

    <!-- Targetas Resumen de Métricas (Fila 1: Ventas) -->
    <div class="row g-3 mb-4">
        <!-- Ventas Hoy -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase font-weight-bold opacity-75">Ventas de Hoy</h6>
                    <h3 class="card-text">Bs. @ViewBag.TotalVentasHoy.ToString("N2")</h3>
                    <small>@ViewBag.CantidadVentasHoy transacciones hoy</small>
                </div>
            </div>
        </div>

        <!-- Ventas del Mes -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase font-weight-bold opacity-75">Ventas del Mes</h6>
                    <h3 class="card-text">Bs. @ViewBag.TotalVentasMes.ToString("N2")</h3>
                    <small>@ViewBag.CantidadVentasMes ventas registradas este mes</small>
                </div>
            </div>
        </div>

        <!-- Promedio por Venta del Mes -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-secondary text-white h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase font-weight-bold opacity-75">Promedio / Venta (Mes)</h6>
                    <h3 class="card-text">Bs. @ViewBag.PromedioVentaMes.ToString("N2")</h3>
                    <small>Ticket promedio mensual</small>
                </div>
            </div>
        </div>

        <!-- Ventas del Año -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-dark text-white h-100">
                <div class="card-body">
                    <h6 class="card-title text-uppercase font-weight-bold opacity-75">Ventas del Año</h6>
                    <h3 class="card-text">Bs. @ViewBag.TotalVentasAño.ToString("N2")</h3>
                    <small>Acumulado anual</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Targetas Resumen de Métricas (Fila 2: Clientes y Stock) -->
    <div class="row g-3 mb-4">
        <!-- Total Clientes -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase font-weight-bold opacity-75">Clientes Registrados</h6>
                        <h3 class="card-text mb-0">@ViewBag.TotalClientes</h3>
                        <small>Clientes </small>
                    </div>
                    <a asp-controller="Clientes" asp-action="Index" class="btn btn-light btn-sm text-success font-weight-bold">Ver Clientes</a>
                </div>
            </div>
        </div>

        <!-- Alertas de Stock -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm bg-danger text-white h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase font-weight-bold opacity-75">Productos en Stock Bajo</h6>
                        <h3 class="card-text mb-0">@ViewBag.ProductosBajoStockCount</h3>
                        <small>Productos por reponer urgentemente</small>
                    </div>
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-light btn-sm text-danger font-weight-bold">Ver Inventario</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Tablas Resumen -->
    <div class="row g-4">
        <!-- Últimas Ventas Realizadas -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white font-weight-bold py-3 d-flex justify-content-between align-items-center">
                    <span>Últimas Ventas</span>
                    <a asp-controller="Ventas" asp-action="Index" class="btn btn-outline-primary btn-sm">Ver Historial Completo</a>
                </div>
                <div class="card-body p-0 table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th># ID</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var v in Model)
                                {
                                    <tr>
                                        <td>#@v.Id</td>
                                        <td>@(v.Cliente != null ? v.Cliente.Nombre + " " + v.Cliente.Apellido : "Cliente General")</td>
                                        <td>@v.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="font-weight-bold">Bs. @v.Total.ToString("N2")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">No hay ventas registradas aún.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Productos con Stock Crítico -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white font-weight-bold py-3">
                    Inventario Crítico
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @if (ViewBag.ListaBajoStock != null && ((List<SistemaVentas.Models.Producto>)ViewBag.ListaBajoStock).Any())
                        {
                            @foreach (var prod in (List<SistemaVentas.Models.Producto>)ViewBag.ListaBajoStock)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@prod.Nombre</strong>
                                    </div>
                                    <span class="badge @(prod.Stock <= 0 ? "bg-danger" : "bg-warning text-dark") rounded-pill">
                                        Stock: @prod.Stock
                                    </span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-center text-muted py-3">
                                Todo el inventario está con stock suficiente
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>