@using SistemaVentas.Models
@model Producto
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="mb-4 text-primary">Editar Producto</h2>

                    <form asp-action="Edit" method="post">
                        <!-- Indispensable para que el controlador sepa qué ID actualizar -->
                        <input type="hidden" asp-for="Id" />

                        <partial name="_Form" model="Model" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver a la lista</a>
                            <button type="submit" class="btn btn-primary">Aceptar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}