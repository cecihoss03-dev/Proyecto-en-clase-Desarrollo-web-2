@model SistemaVentas.Models.Venta

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="ClienteId" class="form-label fw-bold">Cliente</label>
        <select asp-for="ClienteId" class="form-select" asp-items="ViewBag.ClienteId" required>
            <option value="">-- Seleccione un Cliente --</option>
        </select>
        <span asp-validation-for="ClienteId" class="text-danger"></span>
    </div>
    
    <div class="col-md-3">
        <label asp-for="Fecha" class="form-label fw-bold">Fecha</label>
        <input asp-for="Fecha" class="form-control" type="datetime-local" value="@Model.Fecha.ToString("yyyy-MM-ddTHH:mm")" readonly />
    </div>

    <div class="col-md-3">
        <label asp-for="Recibido" class="form-label fw-bold">Monto Recibido (Bs.)</label>
        <input asp-for="Recibido" id="montoRecibido" class="form-control" type="number" step="0.01" min="0" oninput="calcularCambio()" required />
        <span asp-validation-for="Recibido" class="text-danger"></span>
    </div>
</div>

<div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-light fw-bold">Agregar Productos a la Venta</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Producto</label>
                <select id="selectProducto" class="form-select">
                    <option value="">-- Seleccionar Producto --</option>
                    @if (ViewBag.Productos != null)
                    {
                        foreach (var prod in (IEnumerable<SistemaVentas.Models.Producto>)ViewBag.Productos)
                        {
                            <option value="@prod.Id" data-precio="@prod.Precio" data-stock="@prod.Stock" data-nombre="@prod.Nombre">
                                @prod.Nombre - Bs. @Convert.ToDecimal(prod.Precio).ToString("0.00") (Stock: @prod.Stock)
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Cantidad</label>
                <input type="number" id="inputCantidad" class="form-control" value="1" min="1" />
            </div>
            <div class="col-md-3">
                <button type="button" class="btn btn-success w-100" onclick="agregarProducto()">
                    <i class="bi bi-plus-circle"></i> Agregar
                </button>
            </div>
        </div>
    </div>
</div>

<h5 class="mb-3 fw-bold">Detalle de la Venta</h5>
<div class="table-responsive mb-4">
    <table class="table table-bordered align-middle" id="tablaDetalles">
        <thead class="table-light">
            <tr>
                <th>Producto</th>
                <th class="text-end" style="width: 15%;">Precio Unit.</th>
                <th class="text-center" style="width: 15%;">Cantidad</th>
                <th class="text-end" style="width: 20%;">Subtotal</th>
                <th class="text-center" style="width: 10%;">Acción</th>
            </tr>
        </thead>
        <tbody id="tbodyDetalles">
            <!-- Filas dinámicas agregadas por JS -->
        </tbody>
        <tfoot class="table-light fw-bold">
            <tr>
                <td colspan="3" class="text-end">Total a Pagar (Bs.):</td>
                <td class="text-end text-success fs-5" id="lblTotal">0.00</td>
                <td></td>
            </tr>
            <tr>
                <td colspan="3" class="text-end">Cambio (Bs.):</td>
                <td class="text-end text-primary fs-5" id="lblCambio">0.00</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>

<script>
    let contadorDetalle = 0;

    function agregarProducto() {
        const select = document.getElementById("selectProducto");
        const productoId = select.value;
        const optionSelected = select.options[select.selectedIndex];
        
        if (!productoId) {
            alert("Por favor seleccione un producto.");
            return;
        }

        const nombre = optionSelected.getAttribute("data-nombre");
        const precio = parseFloat(optionSelected.getAttribute("data-precio"));
        const stock = parseInt(optionSelected.getAttribute("data-stock"));
        const cantidadInput = document.getElementById("inputCantidad");
        const cantidad = parseInt(cantidadInput.value);

        if (isNaN(cantidad) || cantidad <= 0) {
            alert("Ingrese una cantidad válida.");
            return;
        }

        if (cantidad > stock) {
            alert(`La cantidad supera el stock disponible (${stock}).`);
            return;
        }

        const subtotal = precio * cantidad;

        const tbody = document.getElementById("tbodyDetalles");
        const tr = document.createElement("tr");
        tr.id = `fila-${contadorDetalle}`;
        tr.innerHTML = `
            <td>
                ${nombre}
                <input type="hidden" name="detalles[${contadorDetalle}].ProductoId" value="${productoId}" />
            </td>
            <td class="text-end">
                Bs. ${precio.toFixed(2)}
                <input type="hidden" name="detalles[${contadorDetalle}].PrecioUnitario" value="${precio}" />
            </td>
            <td class="text-center">
                ${cantidad}
                <input type="hidden" name="detalles[${contadorDetalle}].Cantidad" value="${cantidad}" />
            </td>
            <td class="text-end fw-bold">
                Bs. <span class="subtotal-val">${subtotal.toFixed(2)}</span>
                <input type="hidden" name="detalles[${contadorDetalle}].Subtotal" value="${subtotal}" />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarFila(${contadorDetalle})">
                    Quitar
                </button>
            </td>
        `;

        tbody.appendChild(tr);
        contadorDetalle++;
        
        // Reset inputs
        select.value = "";
        cantidadInput.value = "1";

        calcularTotales();
    }

    function eliminarFila(index) {
        const fila = document.getElementById(`fila-${index}`);
        if (fila) {
            fila.remove();
            reindexarDetalles();
            calcularTotales();
        }
    }

    function reindexarDetalles() {
        const filas = document.querySelectorAll("#tbodyDetalles tr");
        filas.forEach((tr, index) => {
            const inputs = tr.querySelectorAll("input[type='hidden']");
            inputs.forEach(input => {
                const nameAttr = input.getAttribute("name");
                if (nameAttr) {
                    const nuevoNombre = nameAttr.replace(/detalles\[\d+\]/, `detalles[${index}]`);
                    input.setAttribute("name", nuevoNombre);
                }
            });
        });
        contadorDetalle = filas.length;
    }

    function calcularTotales() {
        let total = 0;
        const subtotales = document.querySelectorAll(".subtotal-val");
        subtotales.forEach(span => {
            total += parseFloat(span.innerText) || 0;
        });

        document.getElementById("lblTotal").innerText = total.toFixed(2);
        calcularCambio();
    }

    function calcularCambio() {
        const total = parseFloat(document.getElementById("lblTotal").innerText) || 0;
        const recibido = parseFloat(document.getElementById("montoRecibido").value) || 0;
        const cambio = recibido - total;

        document.getElementById("lblCambio").innerText = (cambio > 0 ? cambio : 0).toFixed(2);
    }
</script>