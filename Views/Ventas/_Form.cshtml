@model SistemaVentas.Models.Producto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre del Producto</label>
    <input asp-for="Nombre" class="form-control" placeholder="Ej. Teclado Mecánico" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Precio" class="form-label">Precio (Bs.)</label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoría</label>
        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
            <option value="">-- Seleccione una categoría --</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Stock" class="form-label">Stock Inicial</label>
        <input asp-for="Stock" class="form-control" type="number" placeholder="0" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="StockMinimo" class="form-label">Stock Mínimo (Alerta)</label>
        <input asp-for="StockMinimo" class="form-control" type="number" placeholder="5" />
        <span asp-validation-for="StockMinimo" class="text-danger"></span>
    </div>
</div>