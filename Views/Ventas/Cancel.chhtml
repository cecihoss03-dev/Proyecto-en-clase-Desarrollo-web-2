@model SistemaVentas.Models.Venta
@{
    ViewData["Title"] = "Cancelar Venta";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body p-4">
                    <h3 class="text-danger mb-3">¿Cancelar Venta N° @Model.Id?</h3>
                    <p class="text-muted">Al cancelar esta venta, se reestablecerá automáticamente el stock de los productos involucrados. Esta acción no se puede revertir.</p>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <dl class="row">
                        <dt class="col-sm-4">Fecha:</dt>
                        <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-4">Cliente:</dt>
                        <dd class="col-sm-8">@(Model.Cliente != null ? $"{Model.Cliente.Nombre} {Model.Cliente.Apellido}" : "Sin cliente")</dd>

                        <dt class="col-sm-4">Total:</dt>
                        <dd class="col-sm-8">Bs. @Model.Total.ToString("0.00")</dd>
                    </dl>

                    <form asp-action="Cancel" method="post" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                            <button type="submit" class="btn btn-danger">Confirmar Cancelación</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>