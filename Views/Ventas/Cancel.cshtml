@model SistemaVentas.Models.Venta
@{
    ViewData["Title"] = "Cancelar Venta";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">¿Anular Venta N° @Model.Id?</h4>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted">
                        Esta acción anulará el registro y reestablecerá automáticamente el stock de los productos involucrados en el inventario.
                    </p>

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <dl class="row mb-4">
                        <dt class="col-sm-3">Fecha:</dt>
                        <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Cliente:</dt>
                        <dd class="col-sm-9">
                            @(Model.Cliente != null ? $"{Model.Cliente.Nombre} {Model.Cliente.Apellido}" : "Cliente General")
                        </dd>

                        <dt class="col-sm-3">Total Venta:</dt>
                        <dd class="col-sm-9 fw-bold text-success">Bs. @Model.Total.ToString("0.00")</dd>
                    </dl>

                    <h5 class="mb-3">Productos que retornarán al stock</h5>
                    <div class="table-responsive mb-4">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cantidad</th>
                                    <th class="text-end">Precio Unit.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Detalles != null && Model.Detalles.Any())
                                {
                                    foreach (var detalle in Model.Detalles)
                                    {
                                        <tr>
                                            <td>@(detalle.Producto != null ? detalle.Producto.Nombre : $"Producto ID #{detalle.ProductoId}")</td>
                                            <td class="text-center">@detalle.Cantidad</td>
                                            <td class="text-end">Bs. @Convert.ToDecimal(detalle.Precio).ToString("0.00")</td>
                                            <td class="text-end">Bs. @Convert.ToDecimal(detalle.Subtotal).ToString("0.00")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <form asp-action="Cancel" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
                            <button type="submit" class="btn btn-danger">Confirmar Anulación y Devolver Stock</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>