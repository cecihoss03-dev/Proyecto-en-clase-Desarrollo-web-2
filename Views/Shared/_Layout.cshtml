<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaVentas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.3.3/pulse/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Activo(params string[] nombres) =>
        nombres.Contains(controlador, StringComparer.OrdinalIgnoreCase) ? "active" : "";
    var esAdmin = User.IsInRole("Administrador");
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light navbar-minimarket mb-4">
            <div class="container-fluid">
                <a class="navbar-brand brand-minimarket" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-shop" aria-hidden="true"></i> SistemaVentas
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Mostrar u ocultar el menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Menú principal -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Dashboard")" asp-area="" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @Activo("Ventas")" asp-area="" asp-controller="Ventas" asp-action="Index">
                                <i class="bi bi-cart-check"></i> Ventas
                            </a>
                        </li>

                        <!-- Catálogo -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @Activo("Productos", "Categorias", "Clientes")" href="#" id="catalogoDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-folder2-open"></i> Catálogo
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="catalogoDropdown">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Productos" asp-action="Index">
                                        <i class="bi bi-box-seam me-2"></i> Productos
                                    </a>
                                </li>
                                @if (esAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Categorias" asp-action="Index">
                                            <i class="bi bi-tags me-2"></i> Categorías
                                        </a>
                                    </li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Clientes" asp-action="Index">
                                        <i class="bi bi-people me-2"></i> Clientes
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @if (esAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @Activo("Usuarios")" asp-area="" asp-controller="Usuarios" asp-action="Index">
                                    <i class="bi bi-person-gear"></i> Usuarios
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Usuario -->
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        var nombreUsuario = User.FindFirst("NombreCompleto")?.Value ?? User.Identity!.Name;
                        var rolUsuario = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="usuarioDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @nombreUsuario
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="usuarioDropdown">
                                    <li><span class="dropdown-item-text small fw-bold">@rolUsuario</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="CambiarPassword">
                                            <i class="bi bi-key me-2"></i> Cambiar contraseña
                                        </a>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-minimarket">
        <div class="container text-center">
            &copy; 2026 SistemaVentas
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
