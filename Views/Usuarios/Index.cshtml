@using System.Security.Claims
@using SistemaVentas.Models
@model IEnumerable<Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var idActual = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Usuarios</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Nuevo usuario
    </a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="alert">@mensaje</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>
                        @u.NombreCompleto
                        @if (u.Id.ToString() == idActual)
                        {
                            <span class="badge bg-warning ms-1">Tú</span>
                        }
                    </td>
                    <td>@u.NombreUsuario</td>
                    <td>
                        @if (u.Rol == Roles.Administrador)
                        {
                            <span class="badge bg-primary">Administrador</span>
                        }
                        else
                        {
                            <span class="badge bg-info">Vendedor</span>
                        }
                    </td>
                    <td>
                        @if (u.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Editar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
